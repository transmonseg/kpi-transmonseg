# ─────────────────────────────────────────────────────────────────────
# Supabase — projeto principal
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<seu-projeto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service role key (server-side only — NUNCA expor no client)
# Usada em uploads via storage e RPCs administrativas
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─────────────────────────────────────────────────────────────────────
# Geocodificação do romaneio (Nutry Max) — ponte HTTP pro projeto irmão
# "monitoramento" (POST /api/romaneio/geocode). Ver src/lib/kpi-romaneio/geocode.ts
# ─────────────────────────────────────────────────────────────────────
# URL base do monitoramento (produção no VPS: http://127.0.0.1:3010).
# Se ausente, usa esse mesmo default em runtime.
MONITORAMENTO_URL=http://127.0.0.1:3010

# MESMO valor do MOTOR_SECRET configurado no projeto monitoramento —
# autentica a chamada via header x-motor-key. Sem isso, a geocodificação
# é pulada e todas as linhas ficam sem coordenada (fail-open).
MOTOR_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Ravex (Portefrio) — GPS/telemetria do baú refrigerado
# Ver src/lib/kpi-portefrio/ravex-auth.ts
# ─────────────────────────────────────────────────────────────────────
# Credenciais de login da Ravex (POST /Token, grant_type=password). A
# senha vai em texto plano aqui -- o hash MD5 exigido pela Ravex é
# calculado em runtime pelo código, nunca armazenado já hasheado.
RAVEX_USUARIO=
RAVEX_SENHA=
